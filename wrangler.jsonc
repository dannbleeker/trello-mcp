/**
 * Trello MCP — Cloudflare Worker configuration.
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Required secrets (set via `wrangler secret put NAME`):
 *   GITHUB_CLIENT_ID         — from your GitHub OAuth app
 *   GITHUB_CLIENT_SECRET     — from your GitHub OAuth app
 *   COOKIE_ENCRYPTION_KEY    — `openssl rand -hex 32`
 *   TRELLO_KEY               — Trello API key
 *   TRELLO_TOKEN             — Trello user token
 *
 * Required KV namespace:
 *   wrangler kv namespace create "OAUTH_KV"
 *   then paste the returned id into the `id` field below.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trello-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "migrations": [
    {
      "new_sqlite_classes": ["TrelloMCP"],
      "tag": "v1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "TrelloMCP",
        "name": "MCP_OBJECT"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "6ddeb7f29d9b4cd898cb89a8ff6d3aca"
    }
  ],
  // Daily digest cron. Cloudflare cron is UTC-only, so we fire at 02/03/04 UTC
  // and the handler (src/digest/scheduler.ts) sends exactly once, at or after
  // 04:00 Europe/Copenhagen, DST-proof — the extra firings are retry slots.
  "triggers": {
    "crons": ["0 2 * * *", "0 3 * * *", "0 4 * * *"]
  },
  // Digest addressing. RESEND_API_KEY is a secret (wrangler secret put).
  "vars": {
    "DIGEST_FROM": "Todays Actions <todo@bleeker-pedersen.dk>",
    "DIGEST_TO": "dann@bleeker-pedersen.dk"
  },
  // Import *.html as plain strings (src/dashboard/page.html). Additive; no effect on /mcp.
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"],
      "fallthrough": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8788
  }
}
